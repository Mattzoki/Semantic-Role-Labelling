def classify_data(model, vec, inputdata):
    """
    Classifies input data using a trained model and vectorizer.

    Args:
        model: The trained classification model (e.g., Logistic Regression).
        vec: The vectorizer used to transform the input features.
        inputdata (list of dict): List of feature dictionaries to be classified.

    Returns:
        numpy.ndarray: The predicted labels for the input data.
    """
    features = vec.transform(inputdata)
    predictions = model.predict(features)
    return predictions


